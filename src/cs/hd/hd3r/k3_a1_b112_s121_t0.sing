// k3_a1_b112_s121_t0: shape a=1 b=(1, 1, 2), singles (1, 2, 1), triples 0, D=7
LIB "elim.lib";
proc SAT(ideal I, poly g) { def S = sat(I, g); if (typeof(S) == "list") { ideal J = S[1]; return(J); } return(S); }
ring R = 0, (th1_1, th2_1, th3_1, th3_2, c2, c3, sg1, sg2, sg3, sg4, TT), dp;
proc Aof(poly x) { return((x-0)); }
proc B1(poly x) { return((x-th1_1)); }
proc B2(poly x) { return((x-th2_1)); }
proc B3(poly x) { return((x-th3_1)*(x-th3_2)); }
proc f1(poly x) { return(1 + Aof(x)*B1(x)); }
proc f2(poly x) { return(1 + c2*Aof(x)*B2(x)); }
proc f3(poly x) { return(1 + c3*Aof(x)*B3(x)); }
ideal I = f2(th1_1)*f3(th1_1) - 1, f1(th2_1)*f3(th2_1) - 1, f1(th3_1)*f2(th3_1) - 1, f1(th3_2)*f2(th3_2) - 1, f1(sg1) + 1, f2(sg1)*f3(sg1) - 1, f2(sg2) + 1, f1(sg2)*f3(sg2) - 1, f2(sg3) + 1, f1(sg3)*f3(sg3) - 1, f3(sg4) + 1, f1(sg4)*f2(sg4) - 1;
poly nz = c2*c3*(th1_1-0)*(th2_1-0)*(th2_1-th1_1)*(th3_1-0)*(th3_1-th1_1)*(th3_1-th2_1)*(th3_2-0)*(th3_2-th1_1)*(th3_2-th2_1)*(th3_2-th3_1)*(sg2-sg1)*(sg3-sg1)*(sg3-sg2)*(sg4-sg1)*(sg4-sg2)*(sg4-sg3)*(c2-1);
int t0 = timer; ideal S = std(I + ideal(1 - TT*nz));
print("RESULT k3_a1_b112_s121_t0 D=7 G=4 dim=" + string(dim(S)) + " time=" + string(timer - t0));
quit;

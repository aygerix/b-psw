// k3_a2_b012_s020_t1: shape a=2 b=(0, 1, 2), singles (0, 2, 0), triples 1, D=9
LIB "elim.lib";
proc SAT(ideal I, poly g) { def S = sat(I, g); if (typeof(S) == "list") { ideal J = S[1]; return(J); } return(S); }
ring R = 0, (al2, th2_1, th3_1, th3_2, c2, c3, sg1, sg2, sg3, TT), dp;
proc Aof(poly x) { return((x-0)*(x-al2)); }
proc B1(poly x) { return(1); }
proc B2(poly x) { return((x-th2_1)); }
proc B3(poly x) { return((x-th3_1)*(x-th3_2)); }
proc f1(poly x) { return(1 + Aof(x)*B1(x)); }
proc f2(poly x) { return(1 + c2*Aof(x)*B2(x)); }
proc f3(poly x) { return(1 + c3*Aof(x)*B3(x)); }
ideal I = f1(th2_1)*f3(th2_1) - 1, f1(th3_1)*f2(th3_1) - 1, f1(th3_2)*f2(th3_2) - 1, f2(sg1) + 1, f1(sg1)*f3(sg1) - 1, f2(sg2) + 1, f1(sg2)*f3(sg2) - 1, f1(sg3) + 1, f2(sg3) + 1, f3(sg3) + 1;
poly nz = c2*c3*(al2-0)*(th2_1-0)*(th2_1-al2)*(th3_1-0)*(th3_1-al2)*(th3_1-th2_1)*(th3_2-0)*(th3_2-al2)*(th3_2-th2_1)*(th3_2-th3_1)*(sg2-sg1)*(sg3-sg1)*(sg3-sg2);
int t0 = timer; ideal S = std(I + ideal(1 - TT*nz));
print("RESULT k3_a2_b012_s020_t1 D=9 G=5 dim=" + string(dim(S)) + " time=" + string(timer - t0));
quit;

// k3_a1_b000_s000_t0: shape a=1 b=(0, 0, 0), singles (0, 0, 0), triples 0, D=3
LIB "elim.lib"; option(redSB);
proc SAT(ideal I, poly g) { def S = sat(I, g); if (typeof(S) == "list") { ideal J = S[1]; return(J); } return(S); }
ring R = 0, (c2, c3), dp;
proc Aof(poly x) { return((x-0)); }
proc B1(poly x) { return(1); }
proc B2(poly x) { return(1); }
proc B3(poly x) { return(1); }
proc f1(poly x) { return(1 + Aof(x)*B1(x)); }
proc f2(poly x) { return(1 + c2*Aof(x)*B2(x)); }
proc f3(poly x) { return(1 + c3*Aof(x)*B3(x)); }
ideal I = ;
poly nz = c2*c3*(c2-1)*(c3-1)*(c2-c3);
int t0 = timer; ideal S = SAT(I, nz); S = std(S);
print("RESULT k3_a1_b000_s000_t0 D=3 G=0 dim=" + string(dim(S)) + " time=" + string(timer - t0));
quit;

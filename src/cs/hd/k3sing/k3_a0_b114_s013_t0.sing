// k3_a0_b114_s013_t0: shape a=0 b=(1, 1, 4), singles (0, 1, 3), triples 0, D=6
LIB "elim.lib"; option(redSB);
proc SAT(ideal I, poly g) { def S = sat(I, g); if (typeof(S) == "list") { ideal J = S[1]; return(J); } return(S); }
ring R = 0, (th2_1, th3_1, th3_2, th3_3, th3_4, c2, c3, sg1, sg2, sg3, sg4), dp;
proc Aof(poly x) { return(1); }
proc B1(poly x) { return((x-0)); }
proc B2(poly x) { return((x-th2_1)); }
proc B3(poly x) { return((x-th3_1)*(x-th3_2)*(x-th3_3)*(x-th3_4)); }
proc f1(poly x) { return(1 + Aof(x)*B1(x)); }
proc f2(poly x) { return(1 + c2*Aof(x)*B2(x)); }
proc f3(poly x) { return(1 + c3*Aof(x)*B3(x)); }
ideal I = f2(0)*f3(0) - 1, f1(th2_1)*f3(th2_1) - 1, f1(th3_1)*f2(th3_1) - 1, f1(th3_2)*f2(th3_2) - 1, f1(th3_3)*f2(th3_3) - 1, f1(th3_4)*f2(th3_4) - 1, f2(sg1) + 1, f1(sg1)*f3(sg1) - 1, f3(sg2) + 1, f1(sg2)*f2(sg2) - 1, f3(sg3) + 1, f1(sg3)*f2(sg3) - 1, f3(sg4) + 1, f1(sg4)*f2(sg4) - 1;
poly nz = c2*c3*(th2_1-0)*(th3_1-0)*(th3_1-th2_1)*(th3_2-0)*(th3_2-th2_1)*(th3_2-th3_1)*(th3_3-0)*(th3_3-th2_1)*(th3_3-th3_1)*(th3_3-th3_2)*(th3_4-0)*(th3_4-th2_1)*(th3_4-th3_1)*(th3_4-th3_2)*(th3_4-th3_3)*(sg2-sg1)*(sg3-sg1)*(sg3-sg2)*(sg4-sg1)*(sg4-sg2)*(sg4-sg3)*(c2-1);
int t0 = timer; ideal S = SAT(I, nz); S = std(S);
print("RESULT k3_a0_b114_s013_t0 D=6 G=4 dim=" + string(dim(S)) + " time=" + string(timer - t0));
quit;

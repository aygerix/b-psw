// k3_a1_b002_s001_t1: shape a=1 b=(0, 0, 2), singles (0, 0, 1), triples 1, D=5
LIB "elim.lib"; option(redSB);
proc SAT(ideal I, poly g) { def S = sat(I, g); if (typeof(S) == "list") { ideal J = S[1]; return(J); } return(S); }
ring R = 0, (th3_1, th3_2, c2, c3, sg1, sg2), dp;
proc Aof(poly x) { return((x-0)); }
proc B1(poly x) { return(1); }
proc B2(poly x) { return(1); }
proc B3(poly x) { return((x-th3_1)*(x-th3_2)); }
proc f1(poly x) { return(1 + Aof(x)*B1(x)); }
proc f2(poly x) { return(1 + c2*Aof(x)*B2(x)); }
proc f3(poly x) { return(1 + c3*Aof(x)*B3(x)); }
ideal I = f1(th3_1)*f2(th3_1) - 1, f1(th3_2)*f2(th3_2) - 1, f3(sg1) + 1, f1(sg1)*f2(sg1) - 1, f1(sg2) + 1, f2(sg2) + 1, f3(sg2) + 1;
poly nz = c2*c3*(th3_1-0)*(th3_2-0)*(th3_2-th3_1)*(sg2-sg1)*(c2-1);
int t0 = timer; ideal S = SAT(I, nz); S = std(S);
print("RESULT k3_a1_b002_s001_t1 D=5 G=4 dim=" + string(dim(S)) + " time=" + string(timer - t0));
quit;

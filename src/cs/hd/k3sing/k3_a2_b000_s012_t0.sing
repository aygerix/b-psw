// k3_a2_b000_s012_t0: shape a=2 b=(0, 0, 0), singles (0, 1, 2), triples 0, D=6
LIB "elim.lib"; option(redSB);
proc SAT(ideal I, poly g) { def S = sat(I, g); if (typeof(S) == "list") { ideal J = S[1]; return(J); } return(S); }
ring R = 0, (al2, c2, c3, sg1, sg2, sg3), dp;
proc Aof(poly x) { return((x-0)*(x-al2)); }
proc B1(poly x) { return(1); }
proc B2(poly x) { return(1); }
proc B3(poly x) { return(1); }
proc f1(poly x) { return(1 + Aof(x)*B1(x)); }
proc f2(poly x) { return(1 + c2*Aof(x)*B2(x)); }
proc f3(poly x) { return(1 + c3*Aof(x)*B3(x)); }
ideal I = f2(sg1) + 1, f1(sg1)*f3(sg1) - 1, f3(sg2) + 1, f1(sg2)*f2(sg2) - 1, f3(sg3) + 1, f1(sg3)*f2(sg3) - 1;
poly nz = c2*c3*(al2-0)*(sg2-sg1)*(sg3-sg1)*(sg3-sg2)*(c2-1)*(c3-1)*(c2-c3);
int t0 = timer; ideal S = SAT(I, nz); S = std(S);
print("RESULT k3_a2_b000_s012_t0 D=6 G=3 dim=" + string(dim(S)) + " time=" + string(timer - t0));
quit;

// generated by lp_gen.py pattern [1, 1, 1, 1, 1] char 32003
LIB "elim.lib";
proc SAT(ideal I, poly g) { def S = sat(I, g); if (typeof(S) == "list") { ideal J = S[1]; return(J); } return(S); }
system("--ticks-per-sec", 1000);
ring R = 32003, (x, r2, r3, r4, r5, w, t21, t31, t41, t51), dp;
poly n1 = (w^2 - 1) - 2*(x^2 - 1); poly D1 = (w^2 - 1);
poly n2 = ((t21^2 - 1)*(t21 - r2)) - 2*(x^2 - 1)*(x - r2); poly D2 = ((t21^2 - 1)*(t21 - r2));
poly n3 = ((t31^2 - 1)*(t31 - r3)) - 2*(x^2 - 1)*(x - r3); poly D3 = ((t31^2 - 1)*(t31 - r3));
poly n4 = ((t41^2 - 1)*(t41 - r4)) - 2*(x^2 - 1)*(x - r4); poly D4 = ((t41^2 - 1)*(t41 - r4));
poly n5 = ((t51^2 - 1)*(t51 - r5)) - 2*(x^2 - 1)*(x - r5); poly D5 = ((t51^2 - 1)*(t51 - r5));
ideal I;
I[size(I) + 1] = division(subst(n1, x, r2)*subst(n3, x, r2)*subst(n4, x, r2)*subst(n5, x, r2) - D1*D3*D4*D5, r2^2 - 1)[1][1,1];
I[size(I) + 1] = division(subst(n1, x, r3)*subst(n2, x, r3)*subst(n4, x, r3)*subst(n5, x, r3) - D1*D2*D4*D5, r3^2 - 1)[1][1,1];
I[size(I) + 1] = division(subst(n1, x, r4)*subst(n2, x, r4)*subst(n3, x, r4)*subst(n5, x, r4) - D1*D2*D3*D5, r4^2 - 1)[1][1,1];
I[size(I) + 1] = division(subst(n1, x, r5)*subst(n2, x, r5)*subst(n3, x, r5)*subst(n4, x, r5) - D1*D2*D3*D4, r5^2 - 1)[1][1,1];
I[size(I) + 1] = subst(n2, x, w)*subst(n3, x, w)*subst(n4, x, w)*subst(n5, x, w) - D2*D3*D4*D5;
I[size(I) + 1] = subst(n1, x, t21)*subst(n3, x, t21)*subst(n4, x, t21)*subst(n5, x, t21) - D1*D3*D4*D5;
I[size(I) + 1] = subst(n1, x, t31)*subst(n2, x, t31)*subst(n4, x, t31)*subst(n5, x, t31) - D1*D2*D4*D5;
I[size(I) + 1] = subst(n1, x, t41)*subst(n2, x, t41)*subst(n3, x, t41)*subst(n5, x, t41) - D1*D2*D3*D5;
I[size(I) + 1] = subst(n1, x, t51)*subst(n2, x, t51)*subst(n3, x, t51)*subst(n4, x, t51) - D1*D2*D3*D4;
int t0 = rtimer;
ring S = 32003, (r2, r3, r4, r5, w, t21, t31, t41, t51), dp;
ideal I = imap(R, I);
"pattern [1, 1, 1, 1, 1]: ", size(I), " equations in 9 unknowns";
ideal J = I;
poly sf = (w^2 - 1); J = SAT(J, sf); kill sf; "  sat (w^2 - 1), time ms ", rtimer - t0;
poly sf = ((t21^2 - 1)*(t21 - r2)); J = SAT(J, sf); kill sf; "  sat ((t21^2 - 1)*(t21 - r2)), time ms ", rtimer - t0;
poly sf = ((t31^2 - 1)*(t31 - r3)); J = SAT(J, sf); kill sf; "  sat ((t31^2 - 1)*(t31 - r3)), time ms ", rtimer - t0;
poly sf = ((t41^2 - 1)*(t41 - r4)); J = SAT(J, sf); kill sf; "  sat ((t41^2 - 1)*(t41 - r4)), time ms ", rtimer - t0;
poly sf = ((t51^2 - 1)*(t51 - r5)); J = SAT(J, sf); kill sf; "  sat ((t51^2 - 1)*(t51 - r5)), time ms ", rtimer - t0;
poly sf = r2 - r3; J = SAT(J, sf); kill sf; "  sat r2 - r3, time ms ", rtimer - t0;
poly sf = r2 - r4; J = SAT(J, sf); kill sf; "  sat r2 - r4, time ms ", rtimer - t0;
poly sf = r2 - r5; J = SAT(J, sf); kill sf; "  sat r2 - r5, time ms ", rtimer - t0;
poly sf = r3 - r4; J = SAT(J, sf); kill sf; "  sat r3 - r4, time ms ", rtimer - t0;
poly sf = r3 - r5; J = SAT(J, sf); kill sf; "  sat r3 - r5, time ms ", rtimer - t0;
poly sf = r4 - r5; J = SAT(J, sf); kill sf; "  sat r4 - r5, time ms ", rtimer - t0;
ideal G = std(J); int d = dim(G);
"RESULT pattern [1, 1, 1, 1, 1]: dim ", d, " vdim ", vdim(G), "  time ms ", rtimer - t0;
write(":w lp_11111_p.res", "pattern [1, 1, 1, 1, 1] dim " + string(d) + " vdim " + string(vdim(G)));
quit;

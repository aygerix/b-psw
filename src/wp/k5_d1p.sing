// W' k = 5 all-linear: quick structure of the ideal over GF(32003) (dimension, degree, after saturation).
LIB "primdec.lib";
proc satI(ideal A, ideal B) { def SS = sat(A, B); if (typeof(SS) == "list") { return(SS[1]); } return(SS); }
ring R = 32003, (a2,a3,a4,a5,b2,b3,b4,b5,t,X), dp;
poly f1 = t;
poly f2 = a2*t + b2; poly f3 = a3*t + b3; poly f4 = a4*t + b4; poly f5 = a5*t + b5;
poly P = (X - f1)*(X - f2)*(X - f3)*(X - f4)*(X - f5);
matrix C = coeffs(P, X);
poly E1 = -C[5,1]; poly E2 = C[4,1]; poly E3 = -C[3,1]; poly E4 = C[2,1];
matrix G1 = coeffs(E1 + E3, t); matrix G2 = coeffs(E2 + E4, t);
matrix H1 = coeffs(E1, t); matrix H2 = coeffs(E2, t);
ideal I; ideal H; int i;
for (i = 1; i <= nrows(G1); i++) { I = I, G1[i,1]; }
for (i = 1; i <= nrows(G2); i++) { I = I, G2[i,1]; }
for (i = 1; i <= nrows(H1); i++) { H = H, H1[i,1]; }
for (i = 1; i <= nrows(H2); i++) { H = H, H2[i,1]; }
ring S = 32003, (a2,a3,a4,a5,b2,b3,b4,b5), dp;
ideal I = simplify(imap(R, I), 2); ideal H = simplify(imap(R, H), 2);
int tt = timer;
ideal G = std(I);
"std(I): dim", dim(G), "vdim", vdim(G), "time", timer - tt;
ideal J = satI(I, ideal(a2*a3*a4*a5));
ideal GJ = std(J);
"after sat by a2a3a4a5: dim", dim(GJ), "vdim", vdim(GJ), "time", timer - tt;
// is the monomial ideal H (e1 = e2 = 0 coefficients) contained in the radical of J?
ideal rJ = radical(J);
"radical computed, time", timer - tt;
"H in radical(J):", size(reduce(H, std(rJ))) == 0;
list mp = minAssGTZ(J);
"minimal primes:", size(mp);
for (i = 1; i <= size(mp); i++) { "prime", i, "dim", dim(std(mp[i])), "contains H:", size(reduce(H, std(mp[i]))) == 0; }
quit;

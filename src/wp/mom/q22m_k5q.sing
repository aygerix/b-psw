ring R = 0, (aa,e1,e2,lam,mu,p1,p2,p3,p4,p5,p6,p7,p8,p9), dp;
ideal I =
15/16*e2^4 + ((15*aa - 4)/(4*aa))*e2^3 + (3*p1 + ((45*aa - 24)/(8*aa)))*e2^2 + (3*p2*mu + (((6*aa - 2)/aa)*p1 + ((15*aa - 12)/(4*aa))))*e2 + (p3*mu^2 + ((3*aa - 1)/aa)*p2*mu + (1/2*p1^2 + ((3*aa - 2)/aa)*p1 + (-1/2*p2 + ((15*aa - 16)/(16*aa))))),
0,
0,
-15/2*e2^3 + ((-45*aa + 12)/(2*aa))*e2^2 + (-6*p1 + ((-45*aa + 24)/(2*aa)))*e2 + (-2*p2*mu + (((-6*aa + 2)/aa)*p1 + ((-15*aa + 12)/(2*aa)))),
15/16*e2^4 + ((15*aa - 4)/(4*aa))*e2^3 + (-3*p1 + ((45*aa - 24)/(8*aa)))*e2^2 + (3*p2*mu + (((-6*aa + 2)/aa)*p1 + ((15*aa - 12)/(4*aa))))*e2 + (-p3*mu^2 + ((3*aa - 1)/aa)*p2*mu + (1/2*p1^2 + ((-3*aa + 2)/aa)*p1 + (-1/2*p2 + ((15*aa - 16)/(16*aa))))),
0,
0,
15/2*e2^3 + ((45*aa - 12)/(2*aa))*e2^2 + (-6*p1 + ((45*aa - 24)/(2*aa)))*e2 + (2*p2*mu + (((-6*aa + 2)/aa)*p1 + ((15*aa - 12)/(2*aa)))),
e1, lam, aa*(1 + e2) - 2,
lam*(1 - e1^2 + 2*e2 + e2^2) - 2*e1,
mu*(1 - e1^2 + 2*e2 + e2^2) - 2*(1 - e1^2 + e2);
option(redSB); ideal J = std(I); "dim:"; dim(J); "size:"; size(J); if (size(J) < 30) { J; }
"elim to e1,e2:"; ideal E = eliminate(J, lam*mu*p1*p2*p3*p4*p5*p6*p7*p8*p9); E;
quit;

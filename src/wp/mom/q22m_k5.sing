ring R = 0, (e1,e2,lam,mu,p1,p2,p3,p4,p5,p6,p7,p8,p9), dp;
ideal I =
-15/16*e2*e1^6 + (75/16*e2^2 + 15/4*e2 + p1)*e1^4 - 4*p2*lam*e1^3 + (-45/8*e2^3 - 45/4*e2^2 + (-6*p1 - 45/8)*e2 + (6*p3*lam^2 + (-3*p2*mu - 3*p1)))*e1^2 + (9*p2*lam*e2 + (-4*p4*lam^3 + (6*p3*mu + 6*p2)*lam))*e1 + (15/16*e2^4 + 15/4*e2^3 + (3*p1 + 45/8)*e2^2 + (-4*p3*lam^2 + (3*p2*mu + (6*p1 + 15/4)))*e2 + (p5*lam^4 + (-3*p4*mu - 3*p3)*lam^2 + (p3*mu^2 + 3*p2*mu + (1/2*p1^2 + 3*p1 + (-1/2*p2 + 15/16))))),
15/16*e1^7 + (-45/8*e2 - 15/4)*e1^5 + (75/8*e2^2 + 15*e2 + (4*p1 + 45/8))*e1^3 - 6*p2*lam*e1^2 + (-15/4*e2^3 - 45/4*e2^2 + (-6*p1 - 45/4)*e2 + (4*p3*lam^2 + (-3*p2*mu + (-6*p1 - 15/4))))*e1 + (3*p2*lam*e2 + (-p4*lam^3 + (2*p3*mu + 3*p2)*lam)),
-15/2*e2*e1^5 + (30*e2^2 + 45/2*e2 + p1)*e1^3 - 3*p2*lam*e1^2 + (-45/2*e2^3 - 45*e2^2 + (-9*p1 - 45/2)*e2 + (3*p3*lam^2 + (-2*p2*mu - 3*p1)))*e1 + (5*p2*lam*e2 + (-p4*lam^3 + (2*p3*mu + 3*p2)*lam)),
15/2*e1^6 + (-75/2*e2 - 45/2)*e1^4 + (45*e2^2 + 135/2*e2 + (9*p1 + 45/2))*e1^2 - 7*p2*lam*e1 + (-15/2*e2^3 - 45/2*e2^2 + (-6*p1 - 45/2)*e2 + (2*p3*lam^2 + (-2*p2*mu + (-6*p1 - 15/2)))),
15/16*e1^4 + 2*p2*lam*e1^3 + (45/8*e2^2 + (-3*p1 + 45/4)*e2 + (2*p3*lam^2 + (3*p2*mu + (-6*p1 + 45/8))))*e1^2 + (-3*p2*lam*e2 + (4*p3*mu - 6*p2)*lam)*e1 + (15/16*e2^4 + 15/4*e2^3 + (-3*p1 + 45/8)*e2^2 + (-3*p3*lam^2 + (3*p2*mu + (-6*p1 + 15/4)))*e2 + (-p5*lam^4 + (3*p4*mu - 4*p3)*lam^2 + (-p3*mu^2 + 3*p2*mu + (1/2*p1^2 - 3*p1 + (-1/2*p2 + 15/16))))),
(-15/4*e2 + (p1 - 15/4))*e1^3 + (-15/4*e2^3 - 45/4*e2^2 + (6*p1 - 45/4)*e2 + (p3*lam^2 + (-3*p2*mu + (6*p1 - 15/4))))*e1 + (3*p2*lam*e2 + (p4*lam^3 + (-2*p3*mu + 3*p2)*lam)),
(-45/4*e2 + (p1 - 75/4))*e1^3 + (-15/4*e2^3 - 135/4*e2^2 + (6*p1 - 225/4)*e2 + (p3*lam^2 + (-3*p2*mu + (12*p1 - 105/4))))*e1 + (3*p2*lam*e2 + (p4*lam^3 + (-2*p3*mu + 5*p2)*lam)),
15/4*e1^4 + (45/4*e2^2 + 45*e2 + (-6*p1 + 135/4))*e1^2 - 4*p2*lam*e1 + (15/2*e2^3 + 45/2*e2^2 + (-6*p1 + 45/2)*e2 + (-2*p3*lam^2 + (2*p2*mu + (-6*p1 + 15/2)))),
lam*(1 - e1^2 + 2*e2 + e2^2) - 2*e1,
mu*(1 - e1^2 + 2*e2 + e2^2) - 2*(1 - e1^2 + e2);
option(redSB); ideal J = std(I); "dim:"; dim(J); "size:"; size(J); if (size(J) < 30) { J; }
"elim to e1,e2:"; ideal E = eliminate(J, lam*mu*p1*p2*p3*p4*p5*p6*p7*p8*p9); E;
quit;

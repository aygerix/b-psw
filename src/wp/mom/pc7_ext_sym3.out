z^3 RX/Dl = ((-8*z - 16)*e1^4 + ((8*z^2 + 32*z)*e2 + (4*z^3 + 32*z))*e1^2 + ((-4*z^3 - 8*z^2)*e2^2 + (-8*z^3 - 16*z^2)*e2 + (-4*z^3 - 8*z^2)))/(e1^4 + (-2*e2^2 - 4*e2 - 2)*e1^2 + (e2^4 + 4*e2^3 + 6*e2^2 + 4*e2 + 1))
z^3 RY/Dl = ((-8*z - 16)*e1^4 + ((8*z^2 + 32*z)*e2 + (-4*z^3 + 32*z))*e1^2 + ((4*z^3 - 8*z^2)*e2^2 + (8*z^3 - 16*z^2)*e2 + (4*z^3 - 8*z^2)))/(e1^4 + (-2*e2^2 - 4*e2 - 2)*e1^2 + (e2^4 + 4*e2^3 + 6*e2^2 + 4*e2 + 1))
z^2 dm = (z^2 + 4*z + 4)*e1^2 + ((-4*z^2 - 8*z)*e2 - 8*z)
z^2 dp = 4*e1^2 + (-8*z*e2 + (4*z^2 - 8*z))
(X1+Y1)/2 = ((-8*z - 16)*e1^4 + ((8*z^2 + 32*z)*e2 + 32*z)*e1^2 + (-8*z^2*e2^2 - 16*z^2*e2 - 8*z^2))/(e1^4 + (-2*e2^2 - 4*e2 - 2)*e1^2 + (e2^4 + 4*e2^3 + 6*e2^2 + 4*e2 + 1))   (X1-Y1)/2 = 4*z^3/(e1^2 + (-e2^2 - 2*e2 - 1))

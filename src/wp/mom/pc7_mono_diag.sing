// diagnose the dim-6 result of pc7_mono_F1.sing (p-formulation, M = 1, fixed shape 1/3, -1/5)
LIB "primdec.lib";
< "pc7_mono_F1_body.sing";
ideal J = std(I); "dim F1:"; dim(J);
list L = minAssGTZ(I); "number of minimal primes:"; size(L);
int i; for (i = 1; i <= size(L); i++) { "prime", i, "dim", dim(std(L[i])), "gens", size(L[i]); if (size(L[i]) < 12) { L[i]; } }
quit;

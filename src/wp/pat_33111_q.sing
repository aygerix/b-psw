LIB "primdec.lib"; LIB "modstd.lib";
ring R = 0, (c1_0,c1_1,c2_0,c2_1,c2_2,c2_3,c3_0,c3_1,c4_0,c4_1,c5_0,c5_1,t,X), dp;
poly f1 = c1_0*t^0 + c1_1*t^1 + t^3;
poly f2 = c2_0*t^0 + c2_1*t^1 + c2_2*t^2 + c2_3*t^3;
poly f3 = c3_0*t^0 + c3_1*t^1;
poly f4 = c4_0*t^0 + c4_1*t^1;
poly f5 = c5_0*t^0 + c5_1*t^1;
poly P = (X - f1)*(X - f2)*(X - f3)*(X - f4)*(X - f5);
matrix C = coeffs(P, X);
poly E1 = -C[5,1]; poly E2 = C[4,1]; poly E3 = -C[3,1]; poly E4 = C[2,1];
matrix G1 = coeffs(E1 + E3, t); matrix G2 = coeffs(E2 + E4, t);
matrix H1 = coeffs(E1, t); matrix H2 = coeffs(E2, t);
ideal I; ideal H; int i;
for (i = 1; i <= nrows(G1); i++) { I = I, G1[i,1]; }
for (i = 1; i <= nrows(G2); i++) { I = I, G2[i,1]; }
for (i = 1; i <= nrows(H1); i++) { H = H, H1[i,1]; }
for (i = 1; i <= nrows(H2); i++) { H = H, H2[i,1]; }
ring S = 0, (z,y,c1_0,c1_1,c2_0,c2_1,c2_2,c2_3,c3_0,c3_1,c4_0,c4_1,c5_0,c5_1), dp;
ideal I = simplify(imap(R, I), 2); ideal H = simplify(imap(R, H), 2);
H = c1_0,c1_1,c2_0,c2_1,c2_2,c3_0,c4_0,c5_0;   // criterion: every member is c_j t^(d_j)
ideal Ip = I, 1 - y*c2_3*c3_1*c4_1*c5_1;
"pattern 3,3,1,1,1: unknowns 12, equations", size(I);
int tt = timer;
ideal G0 = std(Ip);
"exact std(Ip) over Q: unit ideal (no solutions):", (size(G0) == 1 && deg(G0[1]) == 0), "dim", dim(G0) - 1, "vdim", vdim(G0), "time", timer - tt;
int allok = 1; ideal T; ideal GT;
for (i = 1; i <= ncols(H); i++) {
  T = Ip, 1 - z*H[i]; GT = std(T);
  "h", i, ": 1 in I + (1 - z h):", (size(GT) == 1 && deg(GT[1]) == 0), "time", timer - tt;
  if (!(size(GT) == 1 && deg(GT[1]) == 0)) { allok = 0; }
}
"ALL COEFFICIENTS OF e1, e2 VANISH ON V(I) (every solution monomial):", allok;
quit;

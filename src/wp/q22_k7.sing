ring R = 0, (t,Z,al,be,ga,de,sg,rh,c1,c2,c3,c4,c5,c6,c7,w), (dp(2),dp);
proc degt(poly f) { if (f == 0) { return(-1); } return(deg(f, intvec(1,0:(nvars(basering)-1)))); }
proc lct(poly f) { int d = degt(f); matrix M = coeffs(f, t); return(M[d+1,1]); }
proc prem(poly f, poly g) { int dg = degt(g); poly lc = lct(g); int df = degt(f);
  while (df >= dg) { f = lc*f - lct(f)*t^(df-dg)*g; df = degt(f); } return(f); }
poly G = t^2 - 1; poly H = t^2 - sg*t + rh;
poly f0 = 1 + G*(al*t + be); poly X = f0 - 1; poly Y = f0 + 1;
ideal I = coeffs(Y - H*(ga*t + de), t);
poly Km; poly Kp; poly Pm; poly Pp; matrix Mc;
Km = al*t + be + c1*H; Kp = ga*t + de + c1*G;
Pm = prem(subst(((c1 + (c1 - c2)*Z)*(c1 + (c1 - c3)*Z)*(c1 + (c1 - c4)*Z)*(c1 + (c1 - c5)*Z)*(c1 + (c1 - c6)*Z)*(c1 + (c1 - c7)*Z) - c1^6)/Z, Z, X), Km); Pp = prem(subst(((c1 - (c1 - c2)*Z)*(c1 - (c1 - c3)*Z)*(c1 - (c1 - c4)*Z)*(c1 - (c1 - c5)*Z)*(c1 - (c1 - c6)*Z)*(c1 - (c1 - c7)*Z) - c1^6)/Z, Z, Y), Kp);
I = I, coeffs(Pm, t), coeffs(Pp, t);
Km = al*t + be + c2*H; Kp = ga*t + de + c2*G;
Pm = prem(subst(((c2 + (c2 - c1)*Z)*(c2 + (c2 - c3)*Z)*(c2 + (c2 - c4)*Z)*(c2 + (c2 - c5)*Z)*(c2 + (c2 - c6)*Z)*(c2 + (c2 - c7)*Z) - c2^6)/Z, Z, X), Km); Pp = prem(subst(((c2 - (c2 - c1)*Z)*(c2 - (c2 - c3)*Z)*(c2 - (c2 - c4)*Z)*(c2 - (c2 - c5)*Z)*(c2 - (c2 - c6)*Z)*(c2 - (c2 - c7)*Z) - c2^6)/Z, Z, Y), Kp);
I = I, coeffs(Pm, t), coeffs(Pp, t);
Km = al*t + be + c3*H; Kp = ga*t + de + c3*G;
Pm = prem(subst(((c3 + (c3 - c1)*Z)*(c3 + (c3 - c2)*Z)*(c3 + (c3 - c4)*Z)*(c3 + (c3 - c5)*Z)*(c3 + (c3 - c6)*Z)*(c3 + (c3 - c7)*Z) - c3^6)/Z, Z, X), Km); Pp = prem(subst(((c3 - (c3 - c1)*Z)*(c3 - (c3 - c2)*Z)*(c3 - (c3 - c4)*Z)*(c3 - (c3 - c5)*Z)*(c3 - (c3 - c6)*Z)*(c3 - (c3 - c7)*Z) - c3^6)/Z, Z, Y), Kp);
I = I, coeffs(Pm, t), coeffs(Pp, t);
Km = al*t + be + c4*H; Kp = ga*t + de + c4*G;
Pm = prem(subst(((c4 + (c4 - c1)*Z)*(c4 + (c4 - c2)*Z)*(c4 + (c4 - c3)*Z)*(c4 + (c4 - c5)*Z)*(c4 + (c4 - c6)*Z)*(c4 + (c4 - c7)*Z) - c4^6)/Z, Z, X), Km); Pp = prem(subst(((c4 - (c4 - c1)*Z)*(c4 - (c4 - c2)*Z)*(c4 - (c4 - c3)*Z)*(c4 - (c4 - c5)*Z)*(c4 - (c4 - c6)*Z)*(c4 - (c4 - c7)*Z) - c4^6)/Z, Z, Y), Kp);
I = I, coeffs(Pm, t), coeffs(Pp, t);
Km = al*t + be + c5*H; Kp = ga*t + de + c5*G;
Pm = prem(subst(((c5 + (c5 - c1)*Z)*(c5 + (c5 - c2)*Z)*(c5 + (c5 - c3)*Z)*(c5 + (c5 - c4)*Z)*(c5 + (c5 - c6)*Z)*(c5 + (c5 - c7)*Z) - c5^6)/Z, Z, X), Km); Pp = prem(subst(((c5 - (c5 - c1)*Z)*(c5 - (c5 - c2)*Z)*(c5 - (c5 - c3)*Z)*(c5 - (c5 - c4)*Z)*(c5 - (c5 - c6)*Z)*(c5 - (c5 - c7)*Z) - c5^6)/Z, Z, Y), Kp);
I = I, coeffs(Pm, t), coeffs(Pp, t);
Km = al*t + be + c6*H; Kp = ga*t + de + c6*G;
Pm = prem(subst(((c6 + (c6 - c1)*Z)*(c6 + (c6 - c2)*Z)*(c6 + (c6 - c3)*Z)*(c6 + (c6 - c4)*Z)*(c6 + (c6 - c5)*Z)*(c6 + (c6 - c7)*Z) - c6^6)/Z, Z, X), Km); Pp = prem(subst(((c6 - (c6 - c1)*Z)*(c6 - (c6 - c2)*Z)*(c6 - (c6 - c3)*Z)*(c6 - (c6 - c4)*Z)*(c6 - (c6 - c5)*Z)*(c6 - (c6 - c7)*Z) - c6^6)/Z, Z, Y), Kp);
I = I, coeffs(Pm, t), coeffs(Pp, t);
Km = al*t + be + c7*H; Kp = ga*t + de + c7*G;
Pm = prem(subst(((c7 + (c7 - c1)*Z)*(c7 + (c7 - c2)*Z)*(c7 + (c7 - c3)*Z)*(c7 + (c7 - c4)*Z)*(c7 + (c7 - c5)*Z)*(c7 + (c7 - c6)*Z) - c7^6)/Z, Z, X), Km); Pp = prem(subst(((c7 - (c7 - c1)*Z)*(c7 - (c7 - c2)*Z)*(c7 - (c7 - c3)*Z)*(c7 - (c7 - c4)*Z)*(c7 - (c7 - c5)*Z)*(c7 - (c7 - c6)*Z) - c7^6)/Z, Z, Y), Kp);
I = I, coeffs(Pm, t), coeffs(Pp, t);
I = I, 1 - w*c1*c2*c3*c4*c5*c6*c7*(c1 - c2)*(c1 - c3)*(c1 - c4)*(c1 - c5)*(c1 - c6)*(c1 - c7)*(c2 - c3)*(c2 - c4)*(c2 - c5)*(c2 - c6)*(c2 - c7)*(c3 - c4)*(c3 - c5)*(c3 - c6)*(c3 - c7)*(c4 - c5)*(c4 - c6)*(c4 - c7)*(c5 - c6)*(c5 - c7)*(c6 - c7)*(sg^2 - 4*rh)*(1 - sg + rh)*(1 + sg + rh);
ring S = 0, (al,be,ga,de,sg,rh,c1,c2,c3,c4,c5,c6,c7,w), dp; ideal J = imap(R, I); J = simplify(J, 2);
"generators:", size(J);
option(redSB); ideal GB = std(J);
if (GB[1] == 1) { "UNIT IDEAL: no (2,2) quartic family"; } else { "NOT UNIT: dim", dim(GB), "vdim", vdim(GB); }
quit;

// W' k = 5, all-linear, second formulation: saturate only by the leading coefficients (nonconstancy),
// decompose, then classify each minimal prime (degenerate: two members equal; or e1 = e2 = 0).
LIB "primdec.lib";
proc satI(ideal A, ideal B) { def SS = sat(A, B); if (typeof(SS) == "list") { return(SS[1]); } return(SS); }
ring R = 0, (a2,a3,a4,a5,b2,b3,b4,b5,t,X), dp;
poly f1 = t;
poly f2 = a2*t + b2; poly f3 = a3*t + b3; poly f4 = a4*t + b4; poly f5 = a5*t + b5;
poly P = (X - f1)*(X - f2)*(X - f3)*(X - f4)*(X - f5);
matrix C = coeffs(P, X);
poly E1 = -C[5,1]; poly E2 = C[4,1]; poly E3 = -C[3,1]; poly E4 = C[2,1];
matrix G1 = coeffs(E1 + E3, t); matrix G2 = coeffs(E2 + E4, t);
matrix H1 = coeffs(E1, t); matrix H2 = coeffs(E2, t);
ideal I; ideal H; int i;
for (i = 1; i <= nrows(G1); i++) { I = I, G1[i,1]; }
for (i = 1; i <= nrows(G2); i++) { I = I, G2[i,1]; }
for (i = 1; i <= nrows(H1); i++) { H = H, H1[i,1]; }
for (i = 1; i <= nrows(H2); i++) { H = H, H2[i,1]; }
ring S = 0, (a2,a3,a4,a5,b2,b3,b4,b5), dp;
ideal I = simplify(imap(R, I), 2); ideal H = simplify(imap(R, H), 2);
ideal J = satI(I, ideal(a2*a3*a4*a5));
"dim J:"; dim(std(J));
list mp = minAssGTZ(J);
"minimal primes:"; size(mp);
list pairs = list(ideal(a2-1,b2), ideal(a3-1,b3), ideal(a4-1,b4), ideal(a5-1,b5),
                  ideal(a2-a3,b2-b3), ideal(a2-a4,b2-b4), ideal(a2-a5,b2-b5),
                  ideal(a3-a4,b3-b4), ideal(a3-a5,b3-b5), ideal(a4-a5,b4-b5));
int j; int k; int deg; int mono;
for (j = 1; j <= size(mp); j++) {
  ideal Q = std(mp[j]);
  deg = 0;
  for (k = 1; k <= size(pairs); k++) { if (size(reduce(pairs[k], Q)) == 0) { deg = 1; } }
  mono = (size(reduce(H, Q)) == 0);
  "component", j, ": dim", dim(Q), " degenerate (two members equal):", deg, " e1 = e2 = 0:", mono;
  if (deg == 0 && mono == 0) { "NON-MONOMIAL NONDEGENERATE COMPONENT:"; mp[j]; }
}
quit;
